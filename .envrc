use flake
# Anchored to the main checkout's .git, not $PWD - a worktree's $PWD differs per worktree, so
# $PWD/.gh_config would resolve to an empty, never-authenticated directory there instead of the
# one real .gh_config where `gh auth login` actually ran.
export GH_CONFIG_DIR="$(dirname "$(git rev-parse --path-format=absolute --git-common-dir)")/.gh_config"
